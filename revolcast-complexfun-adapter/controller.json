{
  "log_dir": "controller-logs",
  "prefix_logs": false,
  "flush_log_each_line": true,
  "servers": [
    {
      "name": "element",
      "enabled": true,
      "auto_start": true,
      "work_dir": "/home/container/element",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "mcdreforged"
      ],
      "env": {},
      "restart": false,
      "restart_wait_seconds": 3
    },
    {
      "name": "afop",
      "enabled": true,
      "auto_start": true,
      "work_dir": "/home/container/afop",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "mcdreforged"
      ],
      "env": {},
      "restart": false,
      "restart_wait_seconds": 3
    },
    {
      "name": "sword",
      "enabled": false,
      "auto_start": false,
      "work_dir": "/home/container/sword",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "mcdreforged"
      ],
      "env": {},
      "restart": false,
      "restart_wait_seconds": 3
    }
  ]
}
