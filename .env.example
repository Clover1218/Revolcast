# ============================================================
# Revolcast 部署配置（docker compose 会自动读取同目录的 .env）
#
# 用法：
#   cp .env.example .env        首次部署
#   docker compose up -d --build
#
# 本文件只影响「容器怎么跑」；应用内部配置全部由 docker-compose.yml 的
# environment 段转成 REVOLCAST_* 环境变量，因此改这里就等于改应用配置。
#
# 部署拓扑：
#   浏览器/公网 → nginx（宿主机，你自己的）→ backend:8080（只监听 127.0.0.1）
#   NapCat（宿主机独立进程）← WS 客户端 ← qq-adapter（容器）
# ============================================================


# ------------------------------------------------------------
# 0. 端口暴露
#
#   BIND_IP 决定「谁能访问这个端口」：
#     127.0.0.1  → 只有本机能连（nginx 反代、SSH 隧道、宿主机工具可用）
#     0.0.0.0    → 所有网卡（公网可直连，务必先配防火墙）
#     10.0.0.5   → 只在该内网 IP 上监听
#
#   因为前面有 nginx，backend 默认收在 127.0.0.1 即可，公网入口交给 nginx。
#   数据库默认也只给宿主机（Navicat / Compass / redis-cli 调试用）；
#   不想暴露就把 docker-compose.yml 里对应服务的 ports 两行注释掉，
#   业务不受影响（容器间走内部网络）。
# ------------------------------------------------------------

COMPOSE_PROJECT_NAME=revolcast

# ----- Backend（nginx 反代到它）-----
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8080

# ----- PostgreSQL -----
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432

# ----- MongoDB -----
MONGO_BIND_IP=127.0.0.1
MONGO_HOST_PORT=27017

# ----- Redis -----
REDIS_BIND_IP=127.0.0.1
REDIS_HOST_PORT=6379

# ----- 容器运行用户 -----
# 0:0 = root。持久化目录是绑定挂载的 ./data，由 Docker 以 root 创建后 uid 100
# 写不进去，默认用 root 最省事。
# 想跑非 root：chown -R 100:100 ./data/logs 后把这里改成 100。
PUID=0
PGID=0


# ------------------------------------------------------------
# 1. 运行环境
# ------------------------------------------------------------

# development | production
#   ⚠️ 切 production 前必须先完成两件事，否则网页会「登录成功但状态丢失」：
#     (1) nginx 上 HTTPS 已生效 —— 会话 Cookie 会带 Secure，纯 HTTP 不回传；
#     (2) WS_ALLOWED_ORIGINS 已填真实域名 —— 浏览器 WS 会按白名单校验，留空即全拒。
#   两项都就绪后再改成 production。
APP_ENV=development

TZ=Asia/Shanghai

# info | debug | warn | error
LOG_LEVEL=info
# json | console（接 ELK/Loki 用 json；本地调试用 console 更易读）
LOG_FORMAT=json
# console | file | both（file/both 写 ./data/logs/<服务>/，docker compose logs 也能看）
LOG_OUTPUT=both


# ------------------------------------------------------------
# 2. 镜像 / 构建
# ------------------------------------------------------------

# 必须与 backend/go.mod、revolcast-qq-adapter/go.mod 的 `go` 指令一致。
# 若 Docker Hub 上没有 golang:1.26.5-alpine 这个 tag，降成 GO_VERSION=1.26 即可。
GO_VERSION=1.26.5

# 国内网络用 goproxy.cn；海外部署可改成 https://proxy.golang.org,direct
GOPROXY=https://goproxy.cn,direct

# Alpine apk 镜像源域名。国内直连 dl-cdn.alpinelinux.org 常年超时，
# 会卡在 `fetch https://dl-cdn.alpinelinux.org/...` 这一步不动。
# 可选值：
#   mirrors.aliyun.com            阿里云（默认）
#   mirrors.tuna.tsinghua.edu.cn  清华
#   mirrors.ustc.edu.cn           中科大
# 留空 = 不改，走 Alpine 官方源（仅海外或已有代理时用）
APK_MIRROR=mirrors.aliyun.com

# 构建期网络模式，保持 default 即可（apk 换源 + GOPROXY 之后下载已经很快）。
# 想彻底复用宿主机网络可以改成 host，但要注意版本差异：
#   · Compose 2.x 直接调用 docker build → 可用；
#   · 新版 Compose 走 buildx bake，需要 network.host 授权，会报
#     "network.host is not allowed" 之类的错误。遇到就改回 default，
#     或绕过 compose 单独构建：
#       docker build --network=host -t revolcast/backend:local ./backend
BUILD_NETWORK=default

# 自建镜像 tag，便于回滚
IMAGE_TAG=local


# ------------------------------------------------------------
# 3. 数据库凭据
#
# 注意：postgres / mongo 的初始化脚本只在「数据目录为空」时执行一次。
#       部署后再改这里的密码，容器里的账号不会跟着变，需要：
#         docker compose down && rm -rf ./data/postgres ./data/mongo   # 会清空数据！
#       或手工进容器改密码。生产环境请在首次部署前就把密码定下来。
#       建议生成方式：openssl rand -hex 16
# ------------------------------------------------------------

POSTGRES_USER=revolcast
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=revolcast
POSTGRES_VERSION=16-alpine

# Mongo 业务账号（backend 用这个连，authSource = revolcast 库）
MONGO_USER=revolcast
MONGO_PASSWORD=change-me-mongo
MONGO_DB=revolcast
# Mongo root 账号（仅运维/备份用，应用不使用）
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_VERSION=7

# Redis 口令，留空 = 不设密码（容器只在内部网络 + 127.0.0.1 时可接受）
REDIS_PASSWORD=
REDIS_VERSION=7-alpine


# ------------------------------------------------------------
# 4. 应用内配置
# ------------------------------------------------------------

# Backend 与 Adapter 之间的共享令牌，两边必须一致（不一致时 Adapter 会被 401 拒绝）。
# 建议：openssl rand -hex 24
WS_TOKEN=change-me-shared-ws-token

# Adapter 的稳定逻辑 ID，用于 Backend 把指令回传到正确的接入端。
# 与数据库中 qq_bindings.bot_id / qq_bind_codes.bot_id 的取值保持一致。
QQ_BOT_ID=revolcast-qq-bot

# 浏览器 WebSocket 的 Origin 白名单，逗号分隔，例：
#   WS_ALLOWED_ORIGINS=https://revolcast.cn,https://www.revolcast.cn
# 仅对 APP_ENV=production 生效；development 下放行任意来源。
# 留空 = 生产环境拒绝所有浏览器 WS（HTTP 接口仍可用）。
WS_ALLOWED_ORIGINS=

# 游戏服务器在线状态采集（BIZ-012）
# 采集周期（秒），状态快照 Redis TTL = 3 × 该值
STATUS_POLL_INTERVAL_SECONDS=60
# 单次等待 RCON 回执上限（秒）
STATUS_POLL_TIMEOUT_SECONDS=5

# 业务队列（有界队列，防 OOM）。默认值适合 2C4G，通常无需修改。
# QUEUE_WORKERS=16
# QUEUE_SIZE=4096
# QUEUE_ENQUEUE_TIMEOUT_MS=200
# QUEUE_TASK_TIMEOUT_MS=5000


# ------------------------------------------------------------
# 5. NapCat（宿主机独立进程，不进 compose）
#
# Adapter 是 WS 客户端，主动连 NapCat，所以这里填 NapCat 的监听地址。
#   - Linux 宿主机：ws://host.docker.internal:6701（compose 已配 host-gateway）
#   - 也可直接填 docker 网桥 IP：ws://172.17.0.1:6701
#
# ⚠️ NapCat 侧必须把「WebSocket 服务器」的监听地址设为 0.0.0.0，
#    只监听 127.0.0.1 时容器无论配什么地址都连不进来。
# ------------------------------------------------------------

NAPCAT_WS_URL=ws://host.docker.internal:6701
# 与 NapCat 的 access_token 一致；NapCat 没设就留空
NAPCAT_TOKEN=

# 触发「@ 机器人」的昵称列表，逗号分隔
BOT_NICKNAME=bot
# 超级用户 QQ 号，逗号分隔，例：BOT_SUPERUSERS=1457095790,10001
# 非法项只告警并忽略，不影响启动
BOT_SUPERUSERS=
# 命令前缀，留空 = 无前缀
BOT_COMMAND_PREFIX=


# ------------------------------------------------------------
# 6. 数据落盘（都在项目目录 ./data 下，备份 = 打包该目录）
#
#   ./data/postgres   建表脚本执行结果 + 全部业务数据
#   ./data/mongo      game_events / server_messages
#   ./data/redis      AOF 持久化的缓存与状态快照（可丢）
#   ./data/logs       backend / adapter 的日志文件
#
# 首次 up 前若手工建目录，注意让容器能写（默认 PUID=0 即 root，无需处理）。
# ------------------------------------------------------------
